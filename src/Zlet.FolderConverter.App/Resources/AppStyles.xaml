    <!-- Format Mark Badge & Glyph Styles -->
    <Style x:Key="RuleFormatBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="#141E30" />
        <Setter Property="BorderBrush" Value="#263650" />
    </Style>

    <Style x:Key="RuleFormatIconStyle" TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Fill" Value="#94A3B8" />
        <Setter Property="Data" Value="{StaticResource GenericFileIconGeometry}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding SemanticFamily}" Value="{x:Static models:FormatSemanticFamily.Document}">
                <Setter Property="Data" Value="{StaticResource DocumentIconGeometry}" />
                <Setter Property="Fill" Value="#60A5FA" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SemanticFamily}" Value="{x:Static models:FormatSemanticFamily.Spreadsheet}">
                <Setter Property="Data" Value="{StaticResource SpreadsheetIconGeometry}" />
                <Setter Property="Fill" Value="#34D399" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SemanticFamily}" Value="{x:Static models:FormatSemanticFamily.Presentation}">
                <Setter Property="Data" Value="{StaticResource PresentationIconGeometry}" />
                <Setter Property="Fill" Value="#FB923C" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SemanticFamily}" Value="{x:Static models:FormatSemanticFamily.Pdf}">
                <Setter Property="Data" Value="{StaticResource PdfIconGeometry}" />
                <Setter Property="Fill" Value="#F87171" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SemanticFamily}" Value="{x:Static models:FormatSemanticFamily.DataCode}">
                <Setter Property="Data" Value="{StaticResource JsonIconGeometry}" />
                <Setter Property="Fill" Value="#38BDF8" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SemanticFamily}" Value="{x:Static models:FormatSemanticFamily.TextData}">
                <Setter Property="Data" Value="{StaticResource TextDataIconGeometry}" />
                <Setter Property="Fill" Value="#2DD4BF" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SemanticFamily}" Value="{x:Static models:FormatSemanticFamily.Image}">
                <Setter Property="Data" Value="{StaticResource ImageIconGeometry}" />
                <Setter Property="Fill" Value="#C084FC" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SemanticFamily}" Value="{x:Static models:FormatSemanticFamily.Ebook}">
                <Setter Property="Data" Value="{StaticResource EbookIconGeometry}" />
                <Setter Property="Fill" Value="#F472B6" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SemanticFamily}" Value="{x:Static models:FormatSemanticFamily.Generic}">
                <Setter Property="Data" Value="{StaticResource GenericFileIconGeometry}" />
                <Setter Property="Fill" Value="#94A3B8" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Office Availability Strip Badges (ZC-036) -->
    <Style x:Key="OfficeBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style x:Key="OfficeWordBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="#1D4ED8" />
        <Setter Property="BorderBrush" Value="#3B82F6" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsWordOfficeAvailable}" Value="False">
                <Setter Property="Background" Value="#1C2434" />
                <Setter Property="BorderBrush" Value="#3A4A62" />
                <Setter Property="Opacity" Value="0.65" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

