<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#060A13" />
    <SolidColorBrush x:Key="PanelBrush" Color="#D90D1626" />
    <SolidColorBrush x:Key="PanelSoftBrush" Color="#172238" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#283956" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3BED1" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#77869E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6C4DFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7D63FF" />
    <!-- Semantic Status Brushes: Ready to copy (Cyan #06B6D4) -->
    <SolidColorBrush x:Key="ReadyCopyStatusBackgroundBrush" Color="#1E06B6D4" />
    <SolidColorBrush x:Key="ReadyCopyStatusBorderBrush" Color="#6006B6D4" />
    <SolidColorBrush x:Key="ReadyCopyStatusForegroundBrush" Color="#67E8F9" />

    <!-- Semantic Status Brushes: Ready to convert (Violet #8B5CF6) -->
    <SolidColorBrush x:Key="ReadyConvertStatusBackgroundBrush" Color="#1E8B5CF6" />
    <SolidColorBrush x:Key="ReadyConvertStatusBorderBrush" Color="#608B5CF6" />
    <SolidColorBrush x:Key="ReadyConvertStatusForegroundBrush" Color="#C4B5FD" />

    <!-- Semantic Status Brushes: In progress (Blue #3B82F6) -->
    <SolidColorBrush x:Key="InProgressStatusBackgroundBrush" Color="#283B82F6" />
    <SolidColorBrush x:Key="InProgressStatusBorderBrush" Color="#703B82F6" />
    <SolidColorBrush x:Key="InProgressStatusForegroundBrush" Color="#93C5FD" />

    <!-- Semantic Status Brushes: Copied (Teal #14B8A6) -->
    <SolidColorBrush x:Key="CopiedStatusBackgroundBrush" Color="#2014B8A6" />
    <SolidColorBrush x:Key="CopiedStatusBorderBrush" Color="#6614B8A6" />
    <SolidColorBrush x:Key="CopiedStatusForegroundBrush" Color="#5EEAD4" />

    <!-- Semantic Status Brushes: Converted / Success (Green #22C55E) -->
    <SolidColorBrush x:Key="SuccessStatusBackgroundBrush" Color="#2022C55E" />
    <SolidColorBrush x:Key="SuccessStatusBorderBrush" Color="#6622C55E" />
    <SolidColorBrush x:Key="SuccessStatusForegroundBrush" Color="#86EFAC" />

    <!-- Semantic Status Brushes: Skipped / Warning (Amber #F59E0B) -->
    <SolidColorBrush x:Key="WarningStatusBackgroundBrush" Color="#20F59E0B" />
    <SolidColorBrush x:Key="WarningStatusBorderBrush" Color="#66F59E0B" />
    <SolidColorBrush x:Key="WarningStatusForegroundBrush" Color="#FDE68A" />

    <!-- Semantic Status Brushes: Conflict (Orange #F97316) -->
    <SolidColorBrush x:Key="ConflictStatusBackgroundBrush" Color="#20F97316" />
    <SolidColorBrush x:Key="ConflictStatusBorderBrush" Color="#66F97316" />
    <SolidColorBrush x:Key="ConflictStatusForegroundBrush" Color="#FDBA74" />

    <!-- Semantic Status Brushes: Failed / Error / Danger (Red #EF4444) -->
    <SolidColorBrush x:Key="DangerStatusBackgroundBrush" Color="#20EF4444" />
    <SolidColorBrush x:Key="DangerStatusBorderBrush" Color="#66EF4444" />
    <SolidColorBrush x:Key="DangerStatusForegroundBrush" Color="#FCA5A5" />

    <!-- Semantic Status Brushes: Unavailable / Neutral (Slate #64748B) -->
    <SolidColorBrush x:Key="UnavailableStatusBackgroundBrush" Color="#1C64748B" />
    <SolidColorBrush x:Key="UnavailableStatusBorderBrush" Color="#4864748B" />
    <SolidColorBrush x:Key="UnavailableStatusForegroundBrush" Color="#94A3B8" />

    <!-- Semantic Status Brushes: Cancelled (Gray-violet #7C6F9B) -->
    <SolidColorBrush x:Key="CancelledStatusBackgroundBrush" Color="#1C7C6F9B" />
    <SolidColorBrush x:Key="CancelledStatusBorderBrush" Color="#487C6F9B" />
    <SolidColorBrush x:Key="CancelledStatusForegroundBrush" Color="#C4BED5" />

    <!-- Legacy compatibility aliases -->
    <SolidColorBrush x:Key="NeutralStatusBrush" Color="#1C64748B" />
    <SolidColorBrush x:Key="WarningStatusBrush" Color="#20F59E0B" />
    <SolidColorBrush x:Key="DangerStatusBrush" Color="#20EF4444" />
    <SolidColorBrush x:Key="SuccessStatusBrush" Color="#2022C55E" />
    <SolidColorBrush x:Key="InProgressStatusBrush" Color="#283B82F6" />
    <SolidColorBrush x:Key="ReadyStatusBrush" Color="#1E8B5CF6" />
    <SolidColorBrush x:Key="CancelledStatusBrush" Color="#1C7C6F9B" />

    <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"
        xmlns:local="clr-namespace:Zlet.FolderConverter.App" />

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="GlassPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="5"
                                  Opacity="0.24"
                                  Color="#02050B" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrivacyBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#55203955" />
        <Setter Property="BorderBrush" Value="#375D84" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="42" />
        <Setter Property="MinWidth" Value="132" />
        <Setter Property="Padding" Value="17,0" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#917CFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#5738D7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#6E7890" />
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#202B3F" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2B3850" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="42" />
        <Setter Property="MinWidth" Value="82" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Background" Value="#17243A" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#334764" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#223453" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4B6A95" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#68758A" />
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#121B2A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Track"
                                Width="34"
                                Height="19"
                                CornerRadius="10"
                                Background="#26344A"
                                BorderBrush="#3B4B65"
                                BorderThickness="1"
                                Margin="0,0,7,0">
                            <Ellipse x:Name="Thumb"
                                     Width="13"
                                     Height="13"
                                     Fill="#A7B2C3"
                                     HorizontalAlignment="Left"
                                     Margin="2" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#9A87FF" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="38" />
        <Setter Property="Background" Value="#17243A" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#334764" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="25" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0"
                                                              Margin="9,0,2,0"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Left" />
                                            <Path Grid.Column="1"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#98A6BA"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="9,0,27,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="#111C2F"
                                    BorderBrush="#3A4D6B"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="260">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#111C2F" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#263B60" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#4C3CAC" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#17243A" />
        <Setter Property="RowBackground" Value="#250F192A" />
        <Setter Property="AlternatingRowBackground" Value="#35132034" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="RowHeight" Value="40" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="SelectionMode" Value="Single" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#42314C70" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#E0192942" />
        <Setter Property="Foreground" Value="#D9E4F2" />
        <Setter Property="BorderBrush" Value="#304662" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="#1B293D" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#F0142034" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#4B668A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
    </Style>

    <!-- Semantic Status Chip Styles -->
    <Style x:Key="StatusChipBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource UnavailableStatusBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UnavailableStatusBorderBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusTone}" Value="ReadyCopy">
                <Setter Property="Background" Value="{StaticResource ReadyCopyStatusBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ReadyCopyStatusBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="ReadyConvert">
                <Setter Property="Background" Value="{StaticResource ReadyConvertStatusBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ReadyConvertStatusBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="InProgress">
                <Setter Property="Background" Value="{StaticResource InProgressStatusBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource InProgressStatusBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Copied">
                <Setter Property="Background" Value="{StaticResource CopiedStatusBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CopiedStatusBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Success">
                <Setter Property="Background" Value="{StaticResource SuccessStatusBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SuccessStatusBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Warning">
                <Setter Property="Background" Value="{StaticResource WarningStatusBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource WarningStatusBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Conflict">
                <Setter Property="Background" Value="{StaticResource ConflictStatusBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ConflictStatusBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Danger">
                <Setter Property="Background" Value="{StaticResource DangerStatusBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerStatusBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Unavailable">
                <Setter Property="Background" Value="{StaticResource UnavailableStatusBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource UnavailableStatusBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Cancelled">
                <Setter Property="Background" Value="{StaticResource CancelledStatusBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CancelledStatusBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{StaticResource UnavailableStatusForegroundBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusTone}" Value="ReadyCopy">
                <Setter Property="Foreground" Value="{StaticResource ReadyCopyStatusForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="ReadyConvert">
                <Setter Property="Foreground" Value="{StaticResource ReadyConvertStatusForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="InProgress">
                <Setter Property="Foreground" Value="{StaticResource InProgressStatusForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Copied">
                <Setter Property="Foreground" Value="{StaticResource CopiedStatusForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Success">
                <Setter Property="Foreground" Value="{StaticResource SuccessStatusForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Warning">
                <Setter Property="Foreground" Value="{StaticResource WarningStatusForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Conflict">
                <Setter Property="Foreground" Value="{StaticResource ConflictStatusForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Danger">
                <Setter Property="Foreground" Value="{StaticResource DangerStatusForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Unavailable">
                <Setter Property="Foreground" Value="{StaticResource UnavailableStatusForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Cancelled">
                <Setter Property="Foreground" Value="{StaticResource CancelledStatusForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
